    "react-native-svg": ">=13"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "lucide-react-native": "latest",
    "react": "^19.1.0",
    "react-native": "^0.81.0",
    "react-native-qrcode-svg": "^6.3.56",
